# Copy this file to env.json for local builds:
#   flutter run --dart-define-from-file=env.json
#
# The app only carries the public Appwrite endpoint and project ID. Gemini and
# Nominatim credentials live in Appwrite Function variables on the server.

# Required for cloud accounts, sync, invites, and AI/search.
# The shared Appwrite instance is self-hosted; use its public URL.
APPWRITE_ENDPOINT=https://YOUR_APPWRITE_HOST/v1
APPWRITE_PROJECT_ID=YOUR_PROJECT_ID

# Deep-link/redirect configuration.
APP_SCHEME=dev.singgah
WEB_BASE_URL=https://YOUR_DOMAIN/

# Google sign-in stays hidden until the provider is configured in Appwrite.
GOOGLE_AUTH_ENABLED=false

# Optional remote push. Public Firebase Android app values plus the Appwrite
# Messaging FCM provider ID. Without these the app still posts local
# notifications, but closed-app Titipan pushes are skipped.
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
APPWRITE_PUSH_PROVIDER_ID=

# --- Server-side only (never put these in env.json or the app) ---
# APPWRITE_API_KEY=standard_...
# APPWRITE_FUNCTION_ENDPOINT=http://host.docker.internal/v1
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash
# OSM_USER_AGENT=SinggahApp/1.0 (https://YOUR_DOMAIN; you@example.com)
